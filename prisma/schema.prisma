// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  name            String?
  memberships     WorkspaceMember[]
  boards          Board[]       @relation("UserBoards")
  boardMemberships Board[]      @relation("BoardMembers")
  comments        Comment[]
  createdAt       DateTime      @default(now())
}

model Workspace {
  id        String           @id @default(uuid())
  name      String
  members   WorkspaceMember[]
  boards    Board[]
  createdAt DateTime         @default(now())
}

model WorkspaceMember {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  workspaceId String
  role        WorkspaceRole
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  VIEWER
}

model Board {
  id          String     @id @default(uuid())
  title       String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  workspaceId String
  owner       User       @relation("UserBoards", fields: [ownerId], references: [id])
  ownerId     String
  members     User[]     @relation("BoardMembers")
  lists       List[]
  createdAt   DateTime   @default(now())
}

model List {
  id        String   @id @default(uuid())
  title     String
  board     Board    @relation(fields: [boardId], references: [id])
  boardId   String
  cards     Card[]
  position  Int
}

model Card {
  id          String    @id @default(uuid())
  title       String
  description String?
  list        List      @relation(fields: [listId], references: [id])
  listId      String
  comments    Comment[]
  labels      Label[]   @relation("CardLabels")
  position    Int
  createdAt   DateTime  @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  card      Card     @relation(fields: [cardId], references: [id])
  cardId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
}

model Label {
  id        String   @id @default(uuid())
  name      String
  color     String
  cards     Card[]   @relation("CardLabels")
}